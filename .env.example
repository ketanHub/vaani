VAANI_ENVIRONMENT=development
VAANI_LOG_LEVEL=INFO
VAANI_DEFAULT_TENANT_ID=demo-clinic

VAANI_DATABASE_URL=sqlite+aiosqlite:///./vaani.db
VAANI_AUTO_CREATE_SCHEMA=false
VAANI_REDIS_URL=redis://127.0.0.1:6379/0
VAANI_REDIS_ENABLED=false

# Optional local speech stack (install with: make voice-setup)
VAANI_LOCAL_VOICE_ENABLED=false
VAANI_LOCAL_VOICE_WARMUP=true
VAANI_WHISPER_MODEL=small
VAANI_WHISPER_DOWNLOAD_ROOT=models/whisper
VAANI_WHISPER_DEVICE=cpu
VAANI_WHISPER_COMPUTE_TYPE=int8
VAANI_WHISPER_NUM_WORKERS=1
VAANI_PIPER_ENGLISH_MODEL=models/piper/en_US-lessac-medium.onnx
VAANI_PIPER_HINDI_MODEL=models/piper/hi_IN-priyamvada-medium.onnx
VAANI_PIPER_USE_CUDA=false
VAANI_PIPER_NUM_WORKERS=1

# Optional CUDA Whisper: make voice-setup-gpu
# Then set VAANI_WHISPER_DEVICE=cuda and VAANI_WHISPER_COMPUTE_TYPE=float16.
# The tested Dell RTX 3050 profile uses 1 Whisper + 1 Piper worker.

# Appointment calendar provider: memory or google.
VAANI_CALENDAR_PROVIDER=memory
VAANI_GOOGLE_CALENDAR_ID=
VAANI_GOOGLE_CALENDAR_ACCESS_TOKEN=

# Optional WhatsApp Business template confirmations.
# Set the complete provider messages endpoint rather than hardcoding API versions.
VAANI_WHATSAPP_MESSAGES_URL=
VAANI_WHATSAPP_ACCESS_TOKEN=
VAANI_WHATSAPP_TEMPLATE_NAME=appointment_confirmation
VAANI_WHATSAPP_TEMPLATE_LANGUAGE=en
VAANI_NOTIFICATIONS_AUTO_DISPATCH=true
VAANI_NOTIFICATIONS_POLL_SECONDS=2.0

# Exotel Voicebot WebSocket adapter.
# Always set a strong secret outside local development.
VAANI_EXOTEL_SHARED_SECRET=
VAANI_EXOTEL_ACCOUNT_SID=
VAANI_EXOTEL_VAD_THRESHOLD=450
VAANI_EXOTEL_ENDPOINT_SILENCE_MS=600

# Docker Compose development credential only. Change outside local development.
POSTGRES_PASSWORD=vaani_local_dev_only
